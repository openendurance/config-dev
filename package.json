{
	"$schema": "https://json.schemastore.org/package",
	"name": "@openendurance/config-dev",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"author": "Kristopher Cargile <k@algorythmic.com>",
	"description": "Shared development configuration for Open Endurance Initiative repositories.",
	"keywords": [
		"open-source",
		"oss",
		"ort",
		"license-compliance",
		"openenduranceinitiative",
		"open-endurance-initiative"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/openendurance/config-dev"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm turbo run build",
		"build:ci": "pnpm turbo run build:ci",
		"changeset": "changeset",
		"changeset:v": "pnpm run version",
		"dev": "pnpm turbo run dev",
		"format": "pnpm run format:biome && pnpm run format:prettier",
		"format:biome": "pnpm exec biome format --write",
		"format:prettier": "pnpm exec prettier --write \"**/*.{md,yml,yaml}\"",
		"lint": "pnpm run lint:root && pnpm run lint:prettier && pnpm turbo run lint",
		"lint:prettier": "pnpm exec prettier --check \"**/*.{md,yml,yaml}\"",
		"lint:root": "pnpm exec prettier --check package.json biome.json tsconfig.json turbo.json renovate.json lint-staged.config.mjs",
		"pre-commit": "lint-staged",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"test": "pnpm turbo run test",
		"typecheck": "pnpm turbo run typecheck",
		"release": "changeset publish",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@openendurance/config-ort": "^0.1.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.9.1",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.0.5",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"turbo": "^2.10.5",
		"typescript": "^6.0.3"
	}
}
