{
	"$schema": "https://json.schemastore.org/package",
	"name": "@openendurance/config-typescript",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"author": "Kristopher Cargile <k@algorythmic.com>",
	"description": "Shared TypeScript configuration presets for Open Endurance Initiative projects.",
	"keywords": [
		"endurance-sports",
		"fitness",
		"healthtech",
		"oei",
		"open-endurance-initiative",
		"open-source",
		"openenduranceinitiative"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/openendurance/config-dev"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"README.md",
		"src"
	],
	"scripts": {
		"build": "pnpm run lint",
		"lint": "pnpm exec biome lint README.md src",
		"prepack": "pnpm run build"
	},
	"exports": {
		"./base.json": "./src/base.json",
		"./node.json": "./src/node.json",
		"./node-library.json": "./src/node-library.json",
		"./web.json": "./src/web.json",
		"./react-native.json": "./src/react-native.json",
		"./electron-main.json": "./src/electron-main.json",
		"./electron-renderer.json": "./src/electron-renderer.json"
	}
}
